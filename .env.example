# ===========================================
# GoWizzYou - Environment Variables
# ===========================================

# Database
DATABASE_URL="postgresql://gowizzyou:gowizzyou_dev@localhost:5432/gowizzyou?schema=public"

# API
API_PORT=3001
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (Kit / ConvertKit)
EMAIL_PROVIDER=kit
KIT_API_KEY=
KIT_API_SECRET=

# SMTP (fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@gowizzyou.com

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# JWT (for future dashboard)
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=3600

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Cal.com
NEXT_PUBLIC_CALCOM_URL=
